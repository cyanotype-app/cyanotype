# Static file server for the built SPA (the `web` image). Not exposed publicly: the gateway proxies to it.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Content-Security-Policy, Permissions-Policy and the cross-origin headers are set by the gateway
	# (infra/caddy/gateway.caddy, csp.caddy), which fronts this container; sending them here too would only risk drift.
	header {
		X-Content-Type-Options nosniff
		-Server
	}
	# Share links send no Referer at all (see the /s handler below).
	@notshare not path /s /s/*
	header @notshare Referrer-Policy strict-origin-when-cross-origin

	# Vite's hashed build output lives under /static (build.assetsDir; /assets is the API's route).
	# Names change with the content, so cache for a year; a missing file is a real 404, not the SPA shell.
	handle /static/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Map label glyphs (vendored Noto Sans, scripts/vendor-map-fonts.sh). A missing range is a real 404, not the SPA shell.
	handle /map/fonts/* {
		@found file
		header @found Cache-Control "public, max-age=604800"
		file_server
	}

	# The downloadable CLI (docs/releases.md): programs, SHA256SUMS(.sig), latest.json and the install scripts, built into the
	# image under /srv/cli. A missing file is a real 404, never the SPA shell (a script piped into `sh` must not get HTML).
	# The metadata files change with every release and are tiny: always revalidate. The programs are named by target, not
	# by version, so they revalidate too (an ETag makes that cheap). The install scripts get the server's own address
	# filled in from the Host the browser used (the gateway forwards it as Host / X-Forwarded-Host).
	handle /cli/* {
		@scripts path /cli/install.sh /cli/install.ps1
		header @scripts Content-Type "text/plain; charset=utf-8"
		templates @scripts
		@meta path /cli/latest.json /cli/SHA256SUMS /cli/SHA256SUMS.sig /cli/UNSIGNED
		header @meta Content-Type "text/plain; charset=utf-8"
		header /cli/latest.json Content-Type "application/json"
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex"
		file_server
	}

	# Share links (/s/<token>): the address is the secret, so keep these pages out of search engines and out of
	# Referer headers. The page itself is the SPA shell; the API answers with the same headers.
	@share path /s /s/*
	handle @share {
		header X-Robots-Tag "noindex, nofollow, noarchive"
		header Referrer-Policy no-referrer
		header Cache-Control "no-cache"
		try_files /index.html
		file_server
	}

	# Everything else: a real file (manifest, icons) or the SPA shell for client-side routes.
	# index.html names the current hashed files, so it must always be revalidated.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
