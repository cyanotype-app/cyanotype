# Shared by every service
DATABASE_URL=postgres://cyanotype:cyanotype@localhost:5432/cyanotype

# Per-service bind addresses (clients reach them through the gateway on :3000)
AUTH_BIND_ADDR=0.0.0.0:3001
ASSETS_BIND_ADDR=0.0.0.0:3002

# Object storage (assets + worker)
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs (what browsers/CLIs can reach). Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cyanotype
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECS=900

# Worker
# WORKER_HEAVY_CONCURRENCY=2
# WORKER_MAX_ORIGINAL_BYTES=209715200

# Logging (see docs/observability.md)
RUST_LOG=info,sqlx=warn
# json | pretty. Default: json unless stdout is a terminal.
# LOG_FORMAT=pretty
# Datadog unified service tags (DD_SERVICE defaults to the binary name, DD_VERSION to the crate version)
# DD_SERVICE=
# DD_ENV=dev
# DD_VERSION=

# Only for `docker compose --profile datadog up -d`; never read by the Rust code.
# DD_API_KEY=
# DD_SITE=datadoghq.com
