DATABASE_URL=postgres://cyanotype:cyanotype@localhost:5432/cyanotype
BIND_ADDR=0.0.0.0:3000
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs (what browsers/CLIs can reach). Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cyanotype
