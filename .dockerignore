# Keep the build context (and therefore cache keys) limited to what the build reads.
# (rust-toolchain.toml is excluded on purpose: the image tag pins Rust; otherwise rustup would fetch components.)
target/
**/target/
.git/
.github/
.env
.env.*
!.env.example
node_modules/
**/node_modules/
docs/
apps/web/
infra/
scripts/
!scripts/fetch-models.sh
models/clip/
models/siglip2/
models/eval/
models/pets/
models/pets-eval/
models/pets-id-eval/
models/pets-embed/
models/pets-bakeoff/
*.md
docker-compose*.yml
docker-bake.hcl
Dockerfile
.dockerignore
justfile
rust-toolchain.toml
cli-dist-out/
