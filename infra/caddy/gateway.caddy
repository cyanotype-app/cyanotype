# Shared gateway routes, imported by Caddyfile (local, :3000) and Caddyfile.prod (real hostname).
# Clients keep talking to one origin and the same URLs as before the service split.
# Hand the upstream exactly one X-Forwarded-For value: the client IP Caddy resolved. That is the TCP peer,
# or (behind Cloudflare, only when the peer is a Cloudflare edge) CF-Connecting-IP. Without this, Caddy
# would append the edge IP to Cloudflare's own X-Forwarded-For and the auth rate limiter would key on edge IPs.
(upstream_client_ip) {
	header_up X-Forwarded-For {client_ip}
}

# CSP header name by CSP_MODE (enforce, the default, or report-only); defines the csp_header snippet used by csp.caddy.
import /etc/caddy/csp/{$CSP_MODE:enforce}.caddy
import /etc/caddy/csp.caddy

# Usage: import gateway ["; extra CSP directive for the web UI"]  (Caddyfile.prod passes "; upgrade-insecure-requests")
(gateway) {
	# Every request gets an id (client-supplied ones are kept); the services echo and log it.
	@noreqid header !X-Request-Id
	request_header @noreqid X-Request-Id {http.request.uuid}

	# Access log as JSON on stdout. Query strings and all headers are dropped so tokens,
	# cookies and Authorization never reach the logs. The one regexp below blanks both: the query (after the "?") and
	# the secret in a share link's address, /s/<token> (the page) and /assets/public/s/<token>/... (its API); the
	# share is logged by its id inside the assets service instead. Caddy allows one filter per field, hence one pattern.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(/s/)[^/?]+|(\?).*" "${1}${2}"
				request>headers delete
				resp_headers delete
			}
		}
	}

	# Security headers on every response, API and web UI alike. `>` defers the write until the upstream answered, so a value
	# the upstream also sends (the web container sets nosniff itself) is replaced, never doubled. The share pages'
	# Referrer-Policy is handled separately (Caddyfile.prod) so that `no-referrer` survives. No X-XSS-Protection: the
	# header is obsolete and the CSP replaces it.
	header {
		>X-Content-Type-Options nosniff
		# Deny every powerful feature the app does not use: no camera, microphone, location, payment, USB/serial/
		# Bluetooth/HID, sensors or screen capture. Clipboard-write (the copy-link buttons) and fullscreen are not listed,
		# so they stay allowed for the app's own origin.
		>Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()"
		>Cross-Origin-Opener-Policy same-origin
		# Only this origin may embed our responses. (Presigned photo URLs are the bucket's own responses, which this
		# header does not touch.)
		>Cross-Origin-Resource-Policy same-origin
	}

	# JSON APIs, CLI downloads and the health check get the lock-everything policy; every other path is the web UI.
	# /cli/authorize is the exception under /cli: it is a page of the web UI (where `cyanotype login` sends the browser to
	# allow the login), so it gets the web UI's policy and not the download area's.
	@cliauth path /cli/authorize
	@api {
		path /auth /auth/* /assets /assets/* /cli /cli/* /healthz
		not path /cli/authorize
	}
	@page not path /auth /auth/* /assets /assets/* /cli /cli/* /healthz
	import csp_api @api
	import csp_spa @page {args[0]}
	import csp_spa @cliauth {args[0]}

	handle /healthz {
		respond `{"ok":true}` 200
	}

	@auth path /auth /auth/*
	handle @auth {
		header >Cache-Control "no-store"
		reverse_proxy auth:3001 {
			import upstream_client_ip
		}
	}

	# Basemap tiles (PMTiles range reads, docs/deploy.md "Map"): the assets service answers them, but unlike the rest
	# of /assets they may be cached by the browser, so no `no-store` here. The service sets Cache-Control itself.
	@tiles path /assets/tiles/*
	handle @tiles {
		reverse_proxy assets:3002 {
			import upstream_client_ip
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	@assets path /assets /assets/*
	# Browser uploads are proxied here too: PUT /assets/uploads/{id}/parts/{n} carries a 16 MiB body. Do NOT add a
	# `request_body { max_size }` limit below that; Caddy does not buffer request bodies by default (they stream to
	# the upstream), and its default timeouts are unlimited. Cloudflare's free plan caps request bodies at 100 MB,
	# so 16 MiB parts pass. The explicit transport timeouts bound a stuck upstream, not slow clients.
	handle @assets {
		header >Cache-Control "no-store"
		reverse_proxy assets:3002 {
			import upstream_client_ip
			transport http {
				dial_timeout 5s
				write_timeout 5m
				response_header_timeout 5m
			}
		}
	}

	# Everything else is the web UI (client-side routes, /static/*, manifest, icons).
	# Keep SPA routes off /auth and /assets, which belong to the APIs above.
	handle {
		reverse_proxy web:8080
	}
}
