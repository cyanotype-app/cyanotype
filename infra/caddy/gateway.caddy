# Shared gateway routes, imported by Caddyfile (local, :3000) and Caddyfile.prod (real hostname).
# Clients keep talking to one origin and the same URLs as before the service split.
# Hand the upstream exactly one X-Forwarded-For value: the client IP Caddy resolved. That is the TCP peer,
# or (behind Cloudflare, only when the peer is a Cloudflare edge) CF-Connecting-IP. Without this, Caddy
# would append the edge IP to Cloudflare's own X-Forwarded-For and the auth rate limiter would key on edge IPs.
(upstream_client_ip) {
	header_up X-Forwarded-For {client_ip}
}

(gateway) {
	# Every request gets an id (client-supplied ones are kept); the services echo and log it.
	@noreqid header !X-Request-Id
	request_header @noreqid X-Request-Id {http.request.uuid}

	# Access log as JSON on stdout. Query strings and all headers are dropped so tokens,
	# cookies and Authorization never reach the logs.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers delete
				resp_headers delete
			}
		}
	}

	handle /healthz {
		respond `{"ok":true}` 200
	}

	@auth path /auth /auth/*
	handle @auth {
		header >Cache-Control "no-store"
		reverse_proxy auth:3001 {
			import upstream_client_ip
		}
	}

	# Basemap tiles (PMTiles range reads, docs/deploy.md "Map"): the assets service answers them, but unlike the rest
	# of /assets they may be cached by the browser, so no `no-store` here. The service sets Cache-Control itself.
	@tiles path /assets/tiles/*
	handle @tiles {
		reverse_proxy assets:3002 {
			import upstream_client_ip
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	@assets path /assets /assets/*
	# Browser uploads are proxied here too: PUT /assets/uploads/{id}/parts/{n} carries a 16 MiB body. Do NOT add a
	# `request_body { max_size }` limit below that; Caddy does not buffer request bodies by default (they stream to
	# the upstream), and its default timeouts are unlimited. Cloudflare's free plan caps request bodies at 100 MB,
	# so 16 MiB parts pass. The explicit transport timeouts bound a stuck upstream, not slow clients.
	handle @assets {
		header >Cache-Control "no-store"
		reverse_proxy assets:3002 {
			import upstream_client_ip
			transport http {
				dial_timeout 5s
				write_timeout 5m
				response_header_timeout 5m
			}
		}
	}

	# Everything else is the web UI (client-side routes, /static/*, manifest, icons).
	# Keep SPA routes off /auth and /assets, which belong to the APIs above.
	handle {
		reverse_proxy web:8080
	}
}
