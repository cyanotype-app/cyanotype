# Local/dev gateway: plain HTTP on :3000, no certificates. Production uses Caddyfile.prod.
# The route definitions live in gateway.caddy (shared by both).
{
	auto_https off
	admin off
	# Errors the gateway logs itself (an upstream that is down answers 502 and Caddy logs the whole request): same
	# redaction as the access log in gateway.caddy, so a share token, a query string or a Cookie never lands there.
	log error_requests {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(/s/)[^/?]+|(\?).*" "${1}${2}"
				request>headers delete
				resp_headers delete
			}
		}
		include http.log.error
	}
}

import /etc/caddy/gateway.caddy

:3000 {
	import gateway
}
