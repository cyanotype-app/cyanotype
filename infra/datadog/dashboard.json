    {
      "definition": {
        "type": "timeseries",
        "title": "Failure rate (failed / finished)",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "display_type": "line",
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "f",
                "query": "sum:cyanotype.jobs.failed{$env}.as_count().rollup(sum, 300)"
              },
              {
                "data_source": "metrics",
                "name": "c",
                "query": "sum:cyanotype.jobs.completed{$env}.as_count().rollup(sum, 300)"
              }
            ],
            "formulas": [
              {
                "formula": "100 * default_zero(f) / (default_zero(f) + default_zero(c))",
                "alias": "failure %"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 14,
        "width": 4,
        "height": 3
