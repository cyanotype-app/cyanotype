{
  "title": "Cyanotype: import and job queue",
  "description": "Queue depth, throughput, failures, durations, worker memory and upload throughput. Import via Dashboards > New Dashboard > Import dashboard JSON.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## Import progress\nQueue depth, throughput and failures of the photo pipeline. Metrics are emitted by the worker (`cyanotype.jobs.*`) and the assets service (`cyanotype.uploads.*`). Template variable `env` = `DD_ENV`.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Queued (all kinds)",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "query": "sum:cyanotype.queue.queued{$env}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
        "width": 3,
        "height": 2
      }
    },
